source "https://rubygems.org"

# Match the Jekyll environment used by GitHub Pages.
gem "github-pages", group: :jekyll_plugins

# Required by `jekyll serve` on Ruby versions where WEBrick is not bundled.
gem "webrick", "~> 1.8"

# macOS system Ruby 2.6 is incompatible with ffi 1.17+.
gem "ffi", "< 1.17"
